<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bebopze.tdx.quant.dal.mapper.ObtTaskLogMapper">


    <delete id="deleteByTaskId">
        DELETE
        FROM obt_task_log
        WHERE task_id = #{taskId}
    </delete>


    <select id="listByTaskId" resultType="com.bebopze.tdx.quant.dal.entity.ObtTaskLogDO">
        SELECT *

        FROM obt_task_log

        WHERE task_id = #{taskId}

        ORDER BY id DESC

        LIMIT #{limit}
    </select>

</mapper>